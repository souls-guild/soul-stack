{{/*
  One concrete unit per instance. It contains no secret values: REDIS_PASSWORD comes from
  a 0600 EnvironmentFile. Optional web/TLS material is sourced from root-only files through
  systemd credentials so DynamicUser can read only protected runtime copies.
*/}}
[Unit]
Description=Prometheus Redis Exporter ({{ .vars.unit_name }})
Documentation=https://github.com/oliver006/redis_exporter
After=network-online.target {{ .vars.dependency_unit }}
Wants=network-online.target
Requires={{ .vars.dependency_unit }}

[Service]
Type=simple
DynamicUser=yes
{{- if .vars.unix_socket }}
# Group access to the local Redis unix socket (770).
SupplementaryGroups=redis
{{- end }}
EnvironmentFile={{ .vars.env_file }}
{{- if .vars.web_config_enabled }}
LoadCredential=web-config:{{ .vars.web_config_file }}
{{- end }}
{{- if .vars.tls_enabled }}
LoadCredential=tls-cert:{{ .vars.tls_cert_file }}
LoadCredential=tls-key:{{ .vars.tls_key_file }}
{{- end }}
ExecStart={{ .vars.bin_dir }}/redis_exporter {{ printf "--redis.addr=%s" .vars.redis_addr | quote }} {{ printf "--web.listen-address=%s" .vars.listen | quote }}{{ if .vars.redis_user }} {{ printf "--redis.user=%s" .vars.redis_user | quote }}{{ end }}{{ if .vars.web_config_enabled }} {{ printf "--web.config.file=/run/credentials/%s.service/web-config" .vars.unit_name | quote }}{{ end }}{{ range .vars.extra_args }} {{ . | quote }}{{ end }}
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
