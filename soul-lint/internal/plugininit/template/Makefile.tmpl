# Makefile for the {{.BinaryName}} module bundle.
#
# `dist/` holds exactly ONE executable and the schema document generated from it.
# The host takes the executable it finds; there is no filename convention, and
# the artifact carries no name of its own.

DIST   := dist
BINARY := $(DIST)/{{.BinaryName}}

# soul-mod is the SDK's build tool: `stamp` puts the generated schema document
# inside the artifact AND writes dist/schema.json, `verify` fails the build when
# the stamped document disagrees with the code it was generated from.
SOUL_MOD ?= soul-mod

.PHONY: build stamp verify test fmt vet check clean

build:
	@mkdir -p $(DIST)
	@go build -trimpath -ldflags="-s -w" -o $(BINARY) ./cmd/{{.BinaryName}}

# Stamping is part of building: an unstamped artifact has no disclosure, and a
# host reading one fails closed rather than assuming an empty schema.
stamp: build
	@$(SOUL_MOD) stamp $(BINARY)

verify:
	@$(SOUL_MOD) verify $(BINARY)

test:
	@go test ./...

fmt:
	@gofmt -w .

vet:
	@go vet ./...

check: fmt vet test stamp verify
	@echo "check: $(BINARY) ok"

clean:
	@rm -rf $(DIST)
